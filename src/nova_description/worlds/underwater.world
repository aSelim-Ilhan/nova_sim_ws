<?xml version="1.0"?>
<sdf version="1.6">
  <world name="underwater">

    <!-- Nötr yüzme: yerçekimi sıfır -->
    <gravity>0 0 0</gravity>

    <physics name="default" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
        </solver>
      </ode>
    </physics>

    <!-- Sualtı ışıklandırması -->
    <scene>
      <ambient>0.05 0.1 0.2 1</ambient>
      <background>0.0 0.05 0.15 1</background>
      <shadows>false</shadows>
      <fog>
        <color>0.0 0.05 0.15 1</color>
        <type>linear</type>
        <start>5</start>
        <end>30</end>
        <density>0.05</density>
      </fog>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.3 0.5 0.7 1</diffuse>
      <specular>0.1 0.2 0.3 1</specular>
      <direction>0.1 0.1 -1</direction>
    </light>

    <!-- Deniz tabanı -->
    <model name="seabed">
      <static>true</static>
      <link name="seabed_link">
        <collision name="col">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.15 0.1 1</ambient>
            <diffuse>0.3 0.25 0.15 1</diffuse>
          </material>
        </visual>
        <pose>0 0 -10 0 0 0</pose>
      </link>
    </model>

    <!-- Gazebo ROS State plugin — /get_entity_state servisi -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50.0</update_rate>
    </plugin>

    <!-- Su yüzeyi (görsel) -->
    <model name="water_surface">
      <static>true</static>
      <link name="surface_link">
        <visual name="vis">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.1 0.4 0.4</ambient>
            <diffuse>0.0 0.2 0.6 0.4</diffuse>
          </material>
        </visual>
        <pose>0 0 5 0 0 0</pose>
      </link>
    </model>

  </world>
</sdf>
